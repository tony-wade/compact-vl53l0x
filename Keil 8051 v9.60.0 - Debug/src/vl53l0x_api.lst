1193   3                              VL53L0X_SetMeasurementTimingBudgetMicroSeconds(Dev,
1194   3                                      MeasurementTimingBudgetMicroSeconds);
1195   3                      }
1196   2              }
1197   1      
1198   1              LOG_FUNCTION_END(Status);
1199   1      
1200   1              return Status;
1201   1      }
