1147   4                                      SequenceConfigNew |= 0x80;
1148   4                                      break;
1149   4                              default:
1150   4                                      Status = VL53L0X_ERROR_INVALID_PARAMS;
1151   4                              }
1152   3                      } else {
1153   3                              /* Disable requested sequence step
