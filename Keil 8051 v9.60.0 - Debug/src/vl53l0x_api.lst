 289          VL53L0X_Error VL53L0X_SetLinearityCorrectiveGain(VL53L0X_DEV Dev,
 290                  int16_t LinearityCorrectiveGain)
 291          {
 292   1              VL53L0X_Error Status = VL53L0X_ERROR_NONE;
 293   1      
 294   1              LOG_FUNCTION_START("");
 295   1      
 296   1              if ((LinearityCorrectiveGain < 0) || (LinearityCorrectiveGain > 1000))
 297   1                      Status = VL53L0X_ERROR_INVALID_PARAMS;
 298   1              else {
 299   2                      PALDevDataSet(Dev, LinearityCorrectiveGain,
 300   2                              LinearityCorrectiveGain);
 301   2      
 302   2                      if (LinearityCorrectiveGain != 1000) {
 303   3                              /* Disable FW Xtalk */
 304   3                              Status = VL53L0X_WrWord(Dev,
 305   3                              VL53L0X_REG_CROSSTALK_COMPENSATION_PEAK_RATE_MCPS, 0);
 306   3                      }
 307   2              }
 308   1      
 309   1              LOG_FUNCTION_END(Status);
 310   1              return Status;
 311   1      }
