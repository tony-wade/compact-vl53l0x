1171   4                              default:
1172   4                                      Status = VL53L0X_ERROR_INVALID_PARAMS;
1173   4                              }
1174   3                      }
1175   2              }
1176   1      
1177   1              if (SequenceConfigNew != SequenceConfig) {
1178   2                      /* Apply New Setting */
1179   2                      if (Status == VL53L0X_ERROR_NONE) {
1180   3                              Status = VL53L0X_WrByte(Dev,
1181   3                              VL53L0X_REG_SYSTEM_SEQUENCE_CONFIG, SequenceConfigNew);
1182   3                      }
1183   2                      if (Status == VL53L0X_ERROR_NONE)
1184   2                              PALDevDataSet(Dev, SequenceConfig, SequenceConfigNew);
