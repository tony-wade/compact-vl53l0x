2313   4                                      if (LoopNb > 0)
2314   4                                              Status = VL53L0X_RdByte(Dev,
2315   4                                              VL53L0X_REG_SYSRANGE_START, &Byte);
2316   4                                      LoopNb = LoopNb + 1;
2317   4                              } while (((Byte & StartStopByte) == StartStopByte)
2318   3                                      && (Status == VL53L0X_ERROR_NONE)
2319   3                                      && (LoopNb < VL53L0X_DEFAULT_MAX_LOOP));
2320   3      
2321   3                              if (LoopNb >= VL53L0X_DEFAULT_MAX_LOOP)
2322   3                                      Status = VL53L0X_ERROR_TIME_OUT;
2323   3      
2324   3                      }
2325   2      
2326   2                      break;
