 198          
 199          VL53L0X_Error VL53L0X_SetPowerMode(VL53L0X_DEV Dev,
 200                                             VL53L0X_PowerModes PowerMode)
 201          {
 202   1              VL53L0X_Error Status = VL53L0X_ERROR_NONE;
 203   1      
 204   1              LOG_FUNCTION_START("");
 205   1      
 206   1              /* Only level1 of Power mode exists */
 207   1              if ((PowerMode != VL53L0X_POWERMODE_STANDBY_LEVEL1)
 208   1                      && (PowerMode != VL53L0X_POWERMODE_IDLE_LEVEL1)) {
 209   2                      Status = VL53L0X_ERROR_MODE_NOT_SUPPORTED;
 210   2              } else if (PowerMode == VL53L0X_POWERMODE_STANDBY_LEVEL1) {
 211   2                      /* set the standby level1 of power mode */
 212   2                      Status = VL53L0X_WrByte(Dev, 0x80, 0x00);
 213   2                      if (Status == VL53L0X_ERROR_NONE) {
 214   3                              /* Set PAL State to standby */
 215   3                              PALDevDataSet(Dev, PalState, VL53L0X_STATE_STANDBY);
 216   3                              PALDevDataSet(Dev, PowerMode,
 217   3                                      VL53L0X_POWERMODE_STANDBY_LEVEL1);
 218   3                      }
 219   2      
 220   2              } else {
 221   2                      /* VL53L0X_POWERMODE_IDLE_LEVEL1 */
 222   2                      Status = VL53L0X_WrByte(Dev, 0x80, 0x00);
 223   2                      if (Status == VL53L0X_ERROR_NONE)
 224   2                              Status = VL53L0X_StaticInit(Dev);
 225   2      
 226   2                      if (Status == VL53L0X_ERROR_NONE)
 227   2                              PALDevDataSet(Dev, PowerMode,
 228   2                                      VL53L0X_POWERMODE_IDLE_LEVEL1);
 229   2      
 230   2              }
 231   1      
 232   1              LOG_FUNCTION_END(Status);
 233   1              return Status;
 234   1      }
 235          
 236          VL53L0X_Error VL53L0X_GetPowerMode(VL53L0X_DEV Dev,
 237                                             VL53L0X_PowerModes *pPowerMode)
 238          {
 239   1              VL53L0X_Error Status = VL53L0X_ERROR_NONE;
 240   1              uint8_t Byte;
 241   1      
 242   1              LOG_FUNCTION_START("");
 243   1      
 244   1              /* Only level1 of Power mode exists */
 245   1              Status = VL53L0X_RdByte(Dev, 0x80, &Byte);
 246   1      
 247   1              if (Status == VL53L0X_ERROR_NONE) {
 248   2                      if (Byte == 1) {
 249   3                              PALDevDataSet(Dev, PowerMode,
 250   3                                      VL53L0X_POWERMODE_IDLE_LEVEL1);
 251   3                      } else {
 252   3                              PALDevDataSet(Dev, PowerMode,
 253   3                                      VL53L0X_POWERMODE_STANDBY_LEVEL1);
 254   3                      }
 255   2              }
 256   1      
 257   1              LOG_FUNCTION_END(Status);
 258   1              return Status;
 259   1      }
