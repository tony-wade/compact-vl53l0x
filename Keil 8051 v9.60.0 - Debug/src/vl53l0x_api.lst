2500   2                      pRangingMeasurementData->EffectiveSpadRtnCount =
2501   2                              EffectiveSpadRtnCount;
2502   2      
2503   2                      DeviceRangeStatus = localBuffer[0];
2504   2      
2505   2                      /* Get Linearity Corrective Gain */
2506   2                      LinearityCorrectiveGain = PALDevDataGet(Dev,
2507   2                              LinearityCorrectiveGain);
2508   2      
2509   2                      /* Get ranging configuration */
2510   2                      RangeFractionalEnable = PALDevDataGet(Dev,
2511   2                              RangeFractionalEnable);
2512   2      
2513   2                      if (LinearityCorrectiveGain != 1000) {
2514   3      
2515   3                              tmpuint16 = (uint16_t)((LinearityCorrectiveGain
2516   3                                      * tmpuint16 + 500) / 1000);
2517   3      
2518   3                              /* Implement Xtalk */
2519   3                              VL53L0X_GETPARAMETERFIELD(Dev,
2521   3                                      XTalkCompensationRateMegaCps,
2521   3                                      XTalkCompensationRateMegaCps);
2522   3                              VL53L0X_GETPARAMETERFIELD(Dev, XTalkCompensationEnable,
2523   3                                      XTalkCompensationEnable);
2524   3      
2525   3                              if (XTalkCompensationEnable) {
2526   4      
2527   4                                      if ((SignalRate
2528   4                                              - ((XTalkCompensationRateMegaCps
