 791          VL53L0X_Error VL53L0X_ResetDevice(VL53L0X_DEV Dev)
 792          {
 793   1              VL53L0X_Error Status = VL53L0X_ERROR_NONE;
 794   1              uint8_t Byte;
 795   1      
 796   1              LOG_FUNCTION_START("");
 797   1      
 798   1              /* Set reset bit */
 799   1              Status = VL53L0X_WrByte(Dev, VL53L0X_REG_SOFT_RESET_GO2_SOFT_RESET_N,
 800   1                      0x00);
 801   1      
 802   1              /* Wait for some time */
 803   1              if (Status == VL53L0X_ERROR_NONE) {
 804   2                      do {
 805   3                              Status = VL53L0X_RdByte(Dev,
 806   3                              VL53L0X_REG_IDENTIFICATION_MODEL_ID, &Byte);
 807   3                      } while (Byte != 0x00);
 808   2              }
 809   1      
 810   1              VL53L0X_PollingDelay(Dev);
 811   1      
 812   1              /* Release reset */
 813   1              Status = VL53L0X_WrByte(Dev, VL53L0X_REG_SOFT_RESET_GO2_SOFT_RESET_N,
 814   1                      0x01);
 815   1      
 816   1              /* Wait until correct boot-up of the device */
 817   1              if (Status == VL53L0X_ERROR_NONE) {
 818   2                      do {
 819   3                              Status = VL53L0X_RdByte(Dev,
 820   3                              VL53L0X_REG_IDENTIFICATION_MODEL_ID, &Byte);
 821   3                      } while (Byte == 0x00);
 822   2              }
 823   1      
 824   1              VL53L0X_PollingDelay(Dev);
 825   1      
 826   1              /* Set PAL State to VL53L0X_STATE_POWERDOWN */
 827   1              if (Status == VL53L0X_ERROR_NONE)
C51 COMPILER V9.60.0.0   VL53L0X_API                                                       09/19/2025 16:16:51 PAGE 15  

 828   1                      PALDevDataSet(Dev, PalState, VL53L0X_STATE_POWERDOWN);
 829   1      
 830   1      
 831   1              LOG_FUNCTION_END(Status);
 832   1              return Status;
 833   1      }
