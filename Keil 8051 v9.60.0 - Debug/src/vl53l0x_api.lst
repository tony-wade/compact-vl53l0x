2495   2                              VL53L0X_FIXPOINT97TOFIXPOINT1616(AmbientRate);
2496   2      
2497   2                      EffectiveSpadRtnCount = VL53L0X_MAKEUINT16(localBuffer[3],
2498   2                              localBuffer[2]);
