 384          VL53L0X_Error VL53L0X_DataInit(VL53L0X_DEV Dev)
 385          {
 386   1              VL53L0X_Error Status = VL53L0X_ERROR_NONE;
C51 COMPILER V9.60.0.0   VL53L0X_API                                                       09/19/2025 16:16:51 PAGE 8   

 387   1              VL53L0X_DeviceParameters_t CurrentParameters;
 388   1              int i;
 389   1              uint8_t StopVariable;
 390   1      
 391   1              LOG_FUNCTION_START("");
 392   1      
 393   1              /* by default the I2C is running at 1V8 if you want to change it you
 394   1               * need to include this define at compilation level.
 395   1               */
 396   1      #ifdef USE_I2C_2V8
                      Status = VL53L0X_UpdateByte(Dev,
                              VL53L0X_REG_VHV_CONFIG_PAD_SCL_SDA__EXTSUP_HV,
                              0xFE,
                              0x01);
              #endif
 402   1      
 403   1              /* Set I2C standard mode */
 404   1              if (Status == VL53L0X_ERROR_NONE)
 405   1                      Status = VL53L0X_WrByte(Dev, 0x88, 0x00);
 406   1      
 407   1              VL53L0X_SETDEVICESPECIFICPARAMETER(Dev, ReadDataFromDeviceDone, 0);
 408   1      
 409   1      #ifdef USE_IQC_STATION
                      if (Status == VL53L0X_ERROR_NONE)
                              Status = VL53L0X_apply_offset_adjustment(Dev);
              #endif
 413   1      
 414   1              /* Default value is 1000 for Linearity Corrective Gain */
 415   1              PALDevDataSet(Dev, LinearityCorrectiveGain, 1000);
 416   1      
 417   1              /* Set Default static parameters
 418   1               *set first temporary values 9.44MHz * 65536 = 618660
 419   1               */
 420   1              VL53L0X_SETDEVICESPECIFICPARAMETER(Dev, OscFrequencyMHz, 618660);
 421   1      
 422   1              /* Set Default XTalkCompensationRateMegaCps to 0  */
 423   1              VL53L0X_SETPARAMETERFIELD(Dev, XTalkCompensationRateMegaCps, 0);
 424   1      
 425   1              /* Get default parameters */
