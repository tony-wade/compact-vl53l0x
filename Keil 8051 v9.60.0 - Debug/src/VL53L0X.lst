 378          
 379          // Set the return signal rate limit check value in units of MCPS (mega counts
 380          // per second). "This represents the amplitude of the signal reflected from the
 381          // target and detected by the device"; setting this limit presumably determines
 382          // the minimum measurement necessary for the sensor to report a valid reading.
 383          // Setting a lower limit increases the potential range of the sensor but also
 384          // seems to increase the likelihood of getting an inaccurate reading because of
 385          // unwanted reflections from objects other than the intended target.
 386          // Defaults to 0.25 MCPS as initialized by the ST API and this library.
 387          bool VL53L0X_setSignalRateLimit(struct VL53L0X *dev, float limit_Mcps)
 388          {
 389   1        if (limit_Mcps < 0 || limit_Mcps > 511.99)
 390   1        {
 391   2          return false;
 392   2        }
 393   1      
 394   1        // Q9.7 fixed point format (9 integer bits, 7 fractional bits)
 395   1        VL53L0X_writeReg16Bit(dev, FINAL_RANGE_CONFIG_MIN_COUNT_RATE_RTN_LIMIT, limit_Mcps * (1 << 7));
 396   1        return true;
 397   1      }
 398          
 399          // Get the return signal rate limit check value in MCPS
 400          float VL53L0X_getSignalRateLimit(struct VL53L0X *dev)
 401          {
 402   1        return (float)VL53L0X_readReg16Bit(dev, FINAL_RANGE_CONFIG_MIN_COUNT_RATE_RTN_LIMIT) / (1 << 7);
 403   1      }
 404          
 405          // Set the measurement timing budget in microseconds, which is the time allowed
 406          // for one measurement. A longer timing budget allows for more accurate
 407          //  measurements. Increasing the budget by a factor of N decreases the range
 408          // measurement standard deviation by a factor of sqrt(N).
 409          // Defaults to about 33 milliseconds; the minimum is 20 ms.
 410          // based on VL53L0X_set_measurement_timing_budget_micro_seconds()
 411          bool VL53L0X_setMeasurementTimingBudget(struct VL53L0X *dev, uint32_t budget_us)
